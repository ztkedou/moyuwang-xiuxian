# ============================================================
# 摸鱼修仙传 · 服务端环境变量示例
# 用法：复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交。
#   cp .env.example .env
# ============================================================

# ---------- 服务端口 ----------
PORT=3000

# ---------- 数据库 ----------
# SQLite 数据库文件路径（相对或绝对路径均可）
DATABASE_PATH=./yl.db

# ---------- 会话与鉴权 ----------
# JWT 签名密钥：请务必改成一段长随机串（例如 openssl rand -hex 64 的输出）。
# 留空时服务端会尝试生成并持久化到 .jwt_secret（仅本地开发方便，生产必须显式配置）。
JWT_SECRET=change-me-to-a-long-random-string

# GM 管理后台口令（/gm-pro/ 入口）。自 0.8.9 起必须显式设置：未设置时服务端会以 [FATAL] 拒绝启动。
GM_PASSWORD=change-me-gm-password

# ---------- 前端来源（CORS / 回跳）----------
FRONTEND_URL=https://example.com

# ---------- AI 历练剧情（可选）----------
# 不配置则 /api/ai/chat 直接返回「未配置」错误，游戏其余功能不受影响。
AI_API_KEY=
AI_API_URL=https://api.siliconflow.cn/v1/chat/completions
AI_MODEL=Qwen/Qwen2.5-7B-Instruct

# ---------- 第三方登录（可选）----------
# 本改版默认已移除 LinuxDO 快捷登录；如要启用请自行填写。
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
